# Production configuration for ToolNimbly.
#
# Every value here is NEXT_PUBLIC_*, which means it is compiled into the client
# bundle and visible to anyone. Nothing secret belongs in this file — it is
# committed so that a production build is reproducible and the legal pages are
# correct for anyone who builds the project.
#
# Secrets, if any are ever needed, go in the host's environment settings and
# never in the repository.

# The canonical origin. Drives canonical tags, sitemap.xml, robots.txt and
# Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.toolnimbly.com

# The entity named in Terms and Privacy, and in the footer copyright.
NEXT_PUBLIC_LEGAL_ENTITY=ToolNimbly Ltd

# The governing law named in Terms.
NEXT_PUBLIC_JURISDICTION=Nigeria

# Contact and security address.
NEXT_PUBLIC_CONTACT_EMAIL=admin@toolnimbly.com

# Analytics and advertising stay off until reviewed. See lib/config/features.ts.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_SITE_ID=
NEXT_PUBLIC_ADS_ENABLED=false
