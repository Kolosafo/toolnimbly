# ToolNimbly environment configuration
# Copy to `.env.local` for development. Never commit real values.
# Every variable is optional in development; see lib/config/ for defaults.

# ---------------------------------------------------------------------------
# Canonical site URL
# ---------------------------------------------------------------------------
# Required in production. Drives canonical tags, sitemap.xml, robots.txt and
# Open Graph URLs. A production build without it logs a loud warning and falls
# back to https://www.toolnimbly.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Legal and contact (spec Appendix C — owner must supply before launch)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=admin@toolnimbly.com
# Registered legal entity named in Terms and Privacy. Blank shows an
# unmistakable "not configured" notice on the legal pages.
NEXT_PUBLIC_LEGAL_ENTITY=
# Governing jurisdiction named in Terms, e.g. "England and Wales".
NEXT_PUBLIC_JURISDICTION=

# ---------------------------------------------------------------------------
# Analytics — disabled for launch (spec §14)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# none | ga4 | vercel | plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# GA4 measurement ID, for example G-ABC123DEF4. The Google script loads only
# after a visitor opts in through the consent control.
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# ---------------------------------------------------------------------------
# Advertising — disabled until the §12 ad-readiness criteria are met
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_PROVIDER=none
NEXT_PUBLIC_ADS_CLIENT_ID=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Opt-in localStorage drafts for the invoice and receipt generators.
NEXT_PUBLIC_DOCUMENT_DRAFTS_ENABLED=true
# Reserved for the optional static-export deployment profile (spec §13.2).
NEXT_PUBLIC_STATIC_EXPORT=false

# ---------------------------------------------------------------------------
# Marble CMS — blog content (docs/marble-integration.md)
# ---------------------------------------------------------------------------
# The blog at /blog is authored in Marble and fetched server-side. The tools,
# guides and legal pages are code-managed and do not depend on any of this.
#
# NOTE: the integration guide calls for NEXT_PUBLIC_APP_URL. This project
# already has NEXT_PUBLIC_SITE_URL above for exactly that purpose, and it is
# reused rather than duplicated — two variables naming the canonical origin is
# how canonical tags and sitemap URLs drift apart.

# Turns the blog on. Leave false until the two secrets below are populated:
# with it off, /blog and /blog/[slug] are not built, not linked and not listed
# in the sitemap, and the rest of the site builds and deploys normally.
NEXT_PUBLIC_BLOG_ENABLED=false

# Marble workspace API key. SERVER-ONLY — must never be prefixed NEXT_PUBLIC_,
# which would inline it into the client bundle and publish it.
# Marble dashboard -> Settings -> API keys.
MARBLE_API_KEY=

# Signing secret for the publish webhook that revalidates /blog on demand.
# Marble dashboard -> Settings -> Webhooks. Server-only, same rule as above.
# Point the webhook at https://<your-domain>/api/revalidate and subscribe to
# post.published, post.updated and post.deleted.
MARBLE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Research: invoice payment terms benchmark (docs/research/data-handling.md)
# ---------------------------------------------------------------------------
# No survey provider and no first-party collection backend has been approved,
# so every variable below is empty or false and the research routes 404.
#
# Turning the survey on requires ALL THREE of the next variables, AND a recorded
# PROVIDER_ASSURANCE in lib/research/survey.ts. With the flag on but no URL,
# provider name or assurance, the landing page still 404s. Configuration is not
# verification: the survey and privacy pages make claims about how the provider
# handles IP addresses, partial answers, deletion identifiers and payment, and a
# hostname establishes none of them. See docs/research/data-handling.md §2.1.
NEXT_PUBLIC_RESEARCH_SURVEY_ENABLED=false
# The approved form's URL, e.g. https://provider.example/forms/abc123.
# Public by nature. Never put a provider API key or token in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_RESEARCH_SURVEY_URL=
# The provider's name, shown to a participant before they leave the site.
NEXT_PUBLIC_RESEARCH_SURVEY_PROVIDER=

# The owner's publication switch for /research/invoice-payment-terms-benchmark-2026.
# It is only half the gate: the route also needs a validated aggregate summary
# at data/research/aggregates/, produced by `pnpm research:build` from a real
# export of at least 100 valid responses, and an editorial review date recorded
# in lib/research/publication.ts. Set this true only after the owner has
# approved the findings, wording, methodology, limitations and date in writing.
NEXT_PUBLIC_RESEARCH_BENCHMARK_PUBLISHED=false
